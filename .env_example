# 数据库配置
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=flaskblog

# 应用配置
DOMAIN=http://localhost:9421
TITLE=zyblog
SECRET_KEY=your-secret-key-change-in-production
TIME_ZONE=Asia/Shanghai

# JWT配置
JWT_EXPIRATION_DELTA=7200
REFRESH_TOKEN_EXPIRATION_DELTA=64800
JWT_SECRET_KEY=your-jwt-secret-key

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 邮件配置
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# 存储配置
UPLOAD_LIMIT=62914560
USER_FREE_STORAGE_LIMIT=536870912

# S3存储配置（开启以支持媒体文件）
S3_ENABLED=True
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=media-bucket
S3_REGION=us-east-1
S3_USE_SSL=True
S3_SIGNATURE_VERSION=s3v4

# 支付配置（可选）
ALIPAY_APPID=
ALIPAY_DEBUG=True
ALIPAY_RETURN_URL=
ALIPAY_NOTIFY_URL=

WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
WECHAT_CERT_SERIAL_NO=

# 备案信息
BEIAN=京ICP备12345678号